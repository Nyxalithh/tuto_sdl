{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build SDL3",
      "type": "shell",
      "command": "C:/msys64/ucrt64/bin/gcc.exe",
      "args": [
        "-g",
        "${file}",
        "-o",
        "${fileDirname}/${fileBasenameNoExtension}.exe",
        "-IC:/msys64/ucrt64/include",
        "-LC:/msys64/ucrt64/lib",
        "-lSDL3"
      ],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    }
  ]
}